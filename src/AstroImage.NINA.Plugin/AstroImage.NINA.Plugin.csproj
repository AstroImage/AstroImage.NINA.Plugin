<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- N.I.N.A. 3.x e' un eseguibile desktop Windows x64 self-contained: un plugin
         non ha scelta sul framework ne' sulla piattaforma.
         Il suffisso di versione c'e' perche' il pannello ospita una pagina in WebView2,
         e 10.0.17763 (Windows 10 RS5) e' il minimo che quel controllo richiede. Era
         scritto qui come previsione fin dal primo giorno; adesso e' il presente. -->
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Nullable>disable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <RootNamespace>AstroImage.NINA.Plugin</RootNamespace>
    <AssemblyName>AstroImage.NINA.Plugin</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- I metadati del manifest li scriviamo a mano in Properties/AssemblyInfo.cs:
         PluginBase li rilegge per riflessione, quindi devono stare li' e non essere
         rigenerati dall'SDK. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- NU1701: dipendenze transitive di N.I.N.A. compilate per .NET Framework. Sono
         irrilevanti a runtime perche' e' N.I.N.A. a fornire le proprie DLL. -->
    <NoWarn>NU1701;CA1416</NoWarn>

  </PropertyGroup>

  <ItemGroup>
    <!--
      LA PAGINA DEL PANNELLO, INCORPORATA NELLA DLL.

      Tre file veri invece di una stringa dentro un .cs: l'editor li vede, il browser li
      apre, e un errore di sintassi si nota mentre lo si scrive invece che a pannello
      aperto. Viaggiano pero' DENTRO il binario, come i due file delle lingue e per la
      stessa ragione: il ponte si distribuisce copiando file, e una sottocartella
      dimenticata nella copia non darebbe un errore — darebbe un pannello bianco.

      Il nome logico e' <RootNamespace>.Views.Pagina.<file>, ed e' quello che Pagina.cs
      va a cercare. Se un giorno la cartella si sposta, va spostato anche li'.
    -->
    <EmbeddedResource Include="Views\Pagina\prova.html" />
    <EmbeddedResource Include="Views\Pagina\prova.css" />
    <EmbeddedResource Include="Views\Pagina\prova.js" />
  </ItemGroup>

  <ItemGroup>
    <!--
      L'SDK di N.I.N.A., e SOLO per compilare.

      `ExcludeAssets: runtime` non e' un dettaglio: N.I.N.A. distribuisce nella propria
      cartella tutte queste DLL, e un plugin che se le portasse dietro caricherebbe una
      seconda copia degli stessi tipi. Da li' in poi un `ISequenceItem` del plugin non
      sarebbe piu' lo stesso tipo di quello di N.I.N.A., e il caricamento fallirebbe in
      un modo che non dice perche'.

      La versione e' la piu' recente STABILE, e coincide con quella dichiarata come
      MinimumApplicationVersion: si compila contro cio' che si dichiara di richiedere.
      Ed e' un pavimento, non un tetto: un plugin compilato contro la 3.2 stabile gira
      anche sulle nightly 3.3. Non e' una deduzione — lo fa gia' AdaptiveAgentForPHD2 su
      questa stessa macchina, con lo stesso riferimento e la stessa dichiarazione.
    -->
    <PackageReference Include="NINA.Plugin" Version="3.2.0.9001">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>

    <!--
      WEBVIEW2, ESCLUSO PER INTERO, E NON PERCHE' NON CI PIACCIA.

      Arriva per via transitiva da uno dei pacchetti di N.I.N.A., e senza questa riga
      la cartella di uscita pesa 1,8 MB invece di 10 KB: tre assembly piu' un loader
      nativo che nessuno ha chiesto. La causa non e' la risoluzione delle dipendenze
      ma un file di build dentro il pacchetto — buildTransitive/Microsoft.Web.WebView2.targets
      — che copia i propri file con Content Include e CopyToOutputDirectory. Un target
      di compilazione non lo ferma nessuna impostazione sulla copia: si esclude il
      pacchetto, e per farlo davvero serve «all», che comprende anche i suoi target.

      Perche' importa: N.I.N.A. distribuisce le proprie DLL di WebView2, e quel
      componente usa versioning stretto. Un plugin che se ne porta una copia diversa
      manda in errore il collegamento a runtime — e' il guasto documentato nel .csproj
      di AdaptiveAgentForPHD2, che WebView2 lo usa davvero e ha dovuto fissarne la
      versione esatta.

      QUEL GIORNO E' ARRIVATO, e la riga e' quella prevista: versione ESATTA e
      «ExcludeAssets: runtime». Che cosa cambia rispetto a «all»: gli assembly servono
      ora a compilare — il pannello ospita davvero una pagina — ma non devono seguire
      il DLL nella cartella dei plugin.

      LA VERSIONE E' LA PIU' BASSA DELLE DUE IN GIRO, di proposito. N.I.N.A. 3.2 stabile
      distribuisce 1.0.3296.44 (verificato sull'installazione di questa macchina: i tre
      assembly Core, WinForms e Wpf dichiarano tutti quella); le nightly 3.3 ne portano
      una piu' recente. WebView2 usa versioning stretto, quindi compilare contro la piu'
      alta romperebbe il collegamento sulla 3.2 — mentre il contrario funziona, ed e'
      esattamente cio' che fa AdaptiveAgentForPHD2, che gira su tutte e due da mesi.

      E i 1,8 MB di cui parla il paragrafo qui sopra? Restano in bin/, non nella cartella
      dei plugin: il passo di installazione copia il solo DLL. La prova sta accanto —
      la cartella distribuita di AdaptiveAgent, che WebView2 lo usa davvero, contiene un
      file solo.
    -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3296.44">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    INSTALLAZIONE A OGNI COMPILAZIONE, accesa di proposito.

    N.I.N.A. carica i plugin da %LOCALAPPDATA%\NINA\Plugins\<Major.Minor.Build>, una
    cartella che dipende dalla versione dell'applicazione. Compilare e poi copiare a mano
    e' il modo piu' facile di provare per mezz'ora un DLL vecchio senza accorgersene: qui
    `dotnet build` lascia sempre in quella cartella l'ultimo binario compilato.

    Restano due cose vere e vanno sapute. La prima: e' una scrittura fuori dal
    repository, dentro l'installazione vera di N.I.N.A. La seconda: N.I.N.A. legge la
    cartella dei plugin all'avvio, quindi il file cambia sotto un programma che, se e'
    aperto, non se ne accorge fino al riavvio successivo; e su Windows, se quel DLL
    fosse gia' caricato, la copia fallirebbe invece di corrompere qualcosa.

    DUE GUARDIE SULLA CONDIZIONE, e nessuna delle due e' pignoleria.

    SOLO IN RELEASE. `dotnet test` compila anche questo progetto, e lo compila in
    Debug: senza questa clausola i test sostituirebbero in N.I.N.A. il binario di
    Release con uno di Debug. Nessun errore, nessun avviso, e la verifica dello
    scheletro che da quel momento dice «DIVERSI».

    MAI DURANTE I TEST, nemmeno in Release. Il target e' AfterTargets="Build", e in
    `dotnet test` la compilazione finisce PRIMA che i test partano: con la sola guardia
    sulla configurazione, `dotnet test -c Release` installava il plugin e poi scopriva
    che i test erano rossi. Nessun passo tornava indietro. VSTestSessionCorrelationId
    la imposta `dotnet test` come proprieta' globale, quindi arriva fin qui ed e' vuota
    in ogni `dotnet build`. Installare e' un atto della compilazione; collaudare non lo
    e', e non deve lasciare niente dietro di se'.

    Per non installare:      dotnet build -p:DeployToNina=false
    Per installare altrove:  dotnet build -p:NinaPluginsFolder=...
  -->
  <PropertyGroup>
    <DeployToNina Condition="'$(DeployToNina)' == ''">true</DeployToNina>
    <!-- La cartella NON porta la versione del pacchetto ma quella dell'APPLICAZIONE
         senza revisione, e per tutta la linea 3.x vale 3.0.0. Verificato guardando dove
         vivono i plugin gia' installati su questa macchina: Astro PM, Advanced API,
         Target Scheduler e Touch 'N' Stars stanno tutti sotto Plugins\3.0.0. Scrivere
         3.2.0 avrebbe prodotto una copia in una cartella che N.I.N.A. non guarda mai. -->
    <NinaPluginsFolder Condition="'$(NinaPluginsFolder)' == ''">$(LOCALAPPDATA)\NINA\Plugins\3.0.0\$(AssemblyName)</NinaPluginsFolder>
  </PropertyGroup>

  <Target Name="DeployPluginToNina" AfterTargets="Build"
          Condition="'$(DeployToNina)' == 'true' And '$(Configuration)' == 'Release' And '$(VSTestSessionCorrelationId)' == ''">
    <MakeDir Directories="$(NinaPluginsFolder)" />

    <!--
      SE N.I.N.A. E' APERTO IL FILE E' BLOCCATO, e la copia non deve far cadere la
      compilazione. Un assembly gia' caricato tiene aperto il proprio file: senza
      ContinueOnError il rame diventa MSB3027, la build fallisce ed e' rossa per un
      motivo che non riguarda il codice. Due tentativi e non di piu': un lock da
      assembly caricato non si libera aspettando, ma due coprono il blocco passeggero
      dell'antivirus sul file appena scritto.

      E si dice come sono andate le cose: il messaggio «copiato» esce solo se la copia
      e' avvenuta davvero, altrimenti esce un avviso che nomina la causa. Un messaggio
      che dice «copiato» quando non lo e' e' peggio del silenzio.
    -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(NinaPluginsFolder)"
          Retries="2" ContinueOnError="WarnAndContinue">
      <Output TaskParameter="CopiedFiles" ItemName="_PluginInstallato" />
    </Copy>
    <Message Importance="high" Condition="'@(_PluginInstallato)' != ''"
             Text="Plugin copiato in $(NinaPluginsFolder)" />
    <Warning Condition="'@(_PluginInstallato)' == ''"
             Text="Plugin NON installato: il file e' in uso, quasi certamente N.I.N.A. e' aperto. Chiudilo e ricompila. scripts/verifica-scheletro.ps1 dice se in N.I.N.A. e' rimasto un binario vecchio." />
  </Target>

</Project>
