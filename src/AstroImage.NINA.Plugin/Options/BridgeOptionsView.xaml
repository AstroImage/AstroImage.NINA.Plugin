<UserControl
    x:Class="AstroImage.NINA.Plugin.Options.BridgeOptionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Niente stili, niente colori: si prendono quelli di N.I.N.A. Un pannello di
        plugin che si porta la propria tavolozza si vede subito, e si vede male.
    -->
    <StackPanel Margin="0,10,0,0" MaxWidth="760" HorizontalAlignment="Left">

        <TextBlock FontWeight="Bold" Margin="0,0,0,6"
                   Text="AstroImage Strategy Bridge" />

        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Porta dentro N.I.N.A. la prescrizione decisa da AstroImage-Strategy: quali canali riprendere, con quante pose, quale posa e quale modo di guadagno. Il ponte non decide niente — riceve una prescrizione già presa e la costruisce nel Sequenziatore Avanzato. Non avvia mai niente: a premere Riproduci sei tu." />

        <!--
            QUI C'ERA SCRITTO «non fa ancora nulla», e per nove commit e' stato falso
            mentre il ponte consegnava bersagli su una montatura vera. Un testo che
            invecchia senza che nessuno lo rilegga e' una piccola bugia che si accumula.
        -->
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Da solo questo plugin non fa niente: dall'altra parte deve esserci AstroImage-Strategy che risponde su una porta HTTP. Senza, il pannello si apre e dice che il motore non risponde." />

        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Tutto si comanda dal pannello «AstroImage Strategy», sotto Imaging: lì si chiede la prescrizione, si dichiara quali filtri hai davvero in ruota — una volta per profilo — e si consegna il bersaglio. Questa pagina non ha ancora impostazioni proprie." />

        <TextBlock TextWrapping="Wrap" FontStyle="Italic"
                   Text="Autore e manutentore: Alessandro Curci. La stesura del codice è stata fatta in larga parte da un assistente di intelligenza artificiale (Claude, di Anthropic), su sua direzione e sotto la sua revisione." />

    </StackPanel>
</UserControl>
