<ResourceDictionary
    x:Class="AstroImage.NINA.Plugin.Resources.DataTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:options="clr-namespace:AstroImage.NINA.Plugin.Options"
    xmlns:views="clr-namespace:AstroImage.NINA.Plugin.Views">

    <!--
        LA PAGINA DELLE OPZIONI NON SI DICHIARA: SI CHIAMA COL NOME GIUSTO.

        Non esiste un'interfaccia da implementare. N.I.N.A. cerca fra le risorse
        dell'applicazione un DataTemplate la cui chiave sia il nome del plugin seguito
        da "_Options", dove il nome e' l'AssemblyTitle. E' una convenzione, non un
        contratto: se la chiave non combacia CARATTERE PER CARATTERE, la pagina esce
        vuota e non lo dice nessuno — nessun errore, nessun avviso in log.

        Per questo il nome del plugin e' scritto in ASCII puro: un trattino lungo o una
        lettera accentata scritti diversamente nei due posti costano una serata.

        Il DataContext che N.I.N.A. mette qui e' l'istanza del plugin stessa, e da li'
        si scende sulle sue Impostazioni: e' quello che la pagina deve poter scrivere.
        Senza questo passaggio la tendina della lingua si vedrebbe e non salverebbe
        niente, senza dare nessun errore.
    -->
    <DataTemplate x:Key="AstroImage Strategy Bridge_Options">
        <options:BridgeOptionsView DataContext="{Binding Impostazioni}" />
    </DataTemplate>

    <!--
        IL PANNELLO, con la stessa convenzione e la stessa trappola.

        La chiave e' il nome COMPLETO del ViewModel seguito da "_Dockable". Vale la
        regola di sopra: se non combacia carattere per carattere, N.I.N.A. non protesta
        — apre un pannello vuoto. Il nome qui sotto deve quindi seguire ogni
        spostamento di namespace o rinomina di PannelloStrategyVM, e non c'e' compilatore
        che se ne accorga.
    -->
    <DataTemplate x:Key="AstroImage.NINA.Plugin.ViewModels.PannelloStrategyVM_Dockable">
        <views:PannelloStrategyView />
    </DataTemplate>

</ResourceDictionary>
