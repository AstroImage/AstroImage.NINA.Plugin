# Modello di scripts/installa.locale.psd1, che git ignora: copialo con quel nome e scrivi i
# nomi delle tue macchine. Per nome e non per indirizzo: gli indirizzi dati dal router cambiano.
@{
    # La cartella dei plugin di N.I.N.A. 3.x sul PC in campo, condivisa in rete.
    Campo  = '\\<pc-in-campo>\3.0.0'

    # L'indirizzo del motore visto dal PC in campo.
    Motore = 'http://<pc-col-motore>:8791/'
}
